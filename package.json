{
	"name": "find-strips",
	"version": "0.1.0",
	"description": "Builds a searchable, prerendered archive of a comic strip from YAML.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/braxtonhall/find-strips.git"
	},
	"bin": {
		"find-strips": "bin/find-strips.mjs"
	},
	"exports": {
		".": "./api/index.ts",
		"./search": "./api/search.ts",
		"./testing": "./api/testing.ts",
		"./package.json": "./package.json"
	},
	"files": [
		"bin",
		"cli",
		"api",
		"src",
		"build-chain",
		"test/helpers",
		"LICENSE",
		"README.md"
	],
	"engines": {
		"node": ">=22.13"
	},
	"dependencies": {
		"@bobs-sink/client": "0.1.0",
		"copy-webpack-plugin": "^13.0.0",
		"css-loader": "^7.1.2",
		"css-minimizer-webpack-plugin": "^8.0.0",
		"js-yaml": "^5.2.3",
		"marked": "^18.0.14",
		"mini-css-extract-plugin": "^2.10.2",
		"node-html-parser": "^9.0.4",
		"serve": "^14.2.6",
		"sharp": "^0.35.5",
		"ts-loader": "^9.5.2",
		"tsx": "^4.23.11",
		"typescript": "^5.9.3",
		"webpack": "^5.99.5",
		"yjs": "^13.6.33"
	},
	"devDependencies": {
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^22.14.1",
		"@types/picomatch": "^4.0.3",
		"@typescript-eslint/eslint-plugin": "^8.66.0",
		"@typescript-eslint/parser": "^8.66.0",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"prettier": "^3.9.6",
		"typescript-eslint": "^8.66.0"
	},
	"scripts": {
		"clean": "rm -rf dist",
		"build": "node bin/find-strips.mjs build demo/config.yaml dist",
		"watch": "node bin/find-strips.mjs build demo/config.yaml dist --mode development --watch",
		"serve": "node bin/find-strips.mjs serve dist",
		"check": "node bin/find-strips.mjs check demo/config.yaml",
		"candidates": "node bin/find-strips.mjs candidates demo/config.yaml",
		"images": "node --import tsx scripts/make-demo-images.ts",
		"test": "yarn test:full && yarn test:bare",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"fix": "yarn lint --fix",
		"pretty": "yarn prettier --write .",
		"prepare": "husky",
		"test:full": "node --import tsx --import ./test/setup.ts --test \"test/*.test.ts\"",
		"test:bare": "node --import tsx --import ./test/bare/setup.ts --test \"test/bare/*.test.ts\""
	},
	"lint-staged": {
		"*.{yml,yaml,md,json,ts,js,html,css}": "prettier --write"
	},
	"prettier": {
		"useTabs": true,
		"printWidth": 120
	}
}
